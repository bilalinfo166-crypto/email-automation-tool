# Copy this file to ".env" and fill in the values.

# Where the SQLite database lives (default is fine)
DATABASE_URL=sqlite:///./warmwire.db

# Path to the OAuth client file you download from Google Cloud Console
GOOGLE_CLIENT_SECRETS=credentials.json

# Must EXACTLY match the redirect URI you set in Google Cloud Console
OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Secret key used to encrypt tokens & app passwords stored in the database.
# Generate one with:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=paste-your-generated-key-here

# The sending domain your senders must belong to (leave blank to allow any)
SENDING_DOMAIN=acme-outreach.com

# Where your frontend runs (for CORS). Use * during local testing.
FRONTEND_ORIGIN=*
